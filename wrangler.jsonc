{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akinator-decisions",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Set secret values via `wrangler secret` (see README).
  // GEMINI_API_KEY : Optional. If set, hides the key input in the UI and all users share this key.
  // TOKEN_SECRET   : Required. Secret key used to encrypt topics; use a long random string.
  "vars": {
    "DECISIONS_MODEL": "gemini-decision-1",
    "TEXT_MODEL": "gemini-3.5-flash-lite",
  },
}
